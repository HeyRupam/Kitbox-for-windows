{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kitbox",
  "version": "0.1.0",
  "identifier": "com.kitbox.desktop",
  "build": {
    "frontendDist": "../../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../../ui run dev",
    "beforeBuildCommand": "npm --prefix ../../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kitbox",
        "width": 1320,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 660,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Offline PDF and image toolkit",
    "longDescription": "Compress images and PDFs to an exact size, convert, and organise documents entirely on your own machine.",
    "windows": {
      "nsis": {
        "installerHooks": "./installer.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
